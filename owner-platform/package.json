{
  "name": "axiomotl-owner-platform",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "import:site": "tsx scripts/import-site.ts",
    "design:build": "tsx scripts/build-combined.ts",
    "test:e2e": "playwright test",
    "prebuild": "node scripts/build-runtime.mjs && npm run design:build",
    "predev": "node scripts/build-runtime.mjs && npm run design:build",
    "format": "prettier --write src scripts tests *.ts *.json *.md",
    "format:check": "prettier --check src scripts tests *.ts *.json *.md"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "cheerio": "^1.2.0",
    "grapesjs": "^0.23.6",
    "grapesjs-parser-postcss": "^1.0.3",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanitize-html": "^2.17.7",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "type": "module"
}
